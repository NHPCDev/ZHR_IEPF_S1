<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    class="sapUiSizeCompact"
>
    <f:SimpleForm
        editable="true"
        layout="ColumnLayout"
    >
        <Label text="Type" />
        <Select
            selectedKey="{viewModel>/selectedType}"
            items="{/F4_UploadTypeSet}"
            editable="false"
        >
            <core:Item
                key="{UPLOAD_TYPE}"
                text="{UPLOAD_TYPE_TEXT}"
            />
        </Select>
        <!-- Start of Change: 08.10.2026 : Balamurugan : Financial Year and Month-Year Fields Added -->
        <Label
            text="{i18n>finYear}"
            required="true"
        />
        <ComboBox
            width="100%"
            selectedItem="{viewModel>/finYear}"
            selectedKey="{viewModel>/finYear}"
            change="onComboboxChange"
            items="{path: '/ZHCM_IEPF_CDS_FINYEAR_F4H'}"
            valueState="{viewModel>/valueState/finYear}"
            valueStateText="{viewModel>/valueStateText/finYear}"
            visible="{= ${viewModel>/selectedType} === 'D' || ${viewModel>/selectedType} === 'S'}"
            editable="false"
        >
            <core:ListItem
                key="{finyear}"
                text="{finyear}"
            />
        </ComboBox>
        <Label
            text="{i18n>submitType}"
            required="true"
        />
        <ComboBox
            width="100%"
            selectedItem="{viewModel>/submitType}"
            selectedKey="{viewModel>/submitType}"
            change="onComboboxChange"
            items="{path: '/ZHCM_CDS_IEPF_SUBMITTYPE'}"
            valueState="{viewModel>/valueState/submitType}"
            valueStateText="{viewModel>/valueStateText/submitType}"
            visible="{= ${viewModel>/selectedType} === 'D'}"
            editable="false"
        >
            <core:ListItem
                key="{StatusValue}"
                text="{StatusText}"
            />
        </ComboBox>
        <Label
            text="{i18n>iepfType}"
            required="true"
        />
        <ComboBox
            width="100%"
            selectedItem="{viewModel>/iepfType}"
            selectedKey="{viewModel>/iepfType}"
            change="onComboboxChange"
            items="{path: '/ZHCM_IEPF_CDS_FINYEAR_F4H'}"
            valueState="{viewModel>/valueState/iepfType}"
            valueStateText="{viewModel>/valueStateText/iepfType}"
            visible="{= ${viewModel>/selectedType} === 'D' || ${viewModel>/selectedType} === 'S'}"
            editable="false"
        >
            <core:ListItem
                key="{finyear}"
                text="{finyear}"
            />
        </ComboBox>
        <Label
            text="{i18n>monYear}"
            required="true"
        />
        <DatePicker
            id="idMonthYear1"
            displayFormat="MM.yyyy"
            valueFormat="yyyyMM"
            value="{viewModel>/monthYear}"
            visible="false"
            editable="false"
        />
        <!-- End of Change: 08.10.2026 : Balamurugan : Financial Year and Month-Year Fields Added -->
    </f:SimpleForm>
</core:FragmentDefinition>

<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    class="sapUiSizeCompact"
>
    <Dialog
        id="idCreateDialog"
        title="{i18n>createDialogTitle}"
        draggable="false"
        titleAlignment="Center"
        class="sapUiSizeCompact"
        contentWidth="25rem"
    >
        <content>
            <VBox>
                <f:SimpleForm
                    editable="true"
                    layout="ResponsiveGridLayout"
                >
                    <f:content>
                        <Label
                            text="{i18n>chooseType}"
                            required="true"
                        />
                        <ComboBox
                            width="100%"
                            selectedItem="{viewModel>/selectedType}"
                            selectedKey="{viewModel>/selectedType}"
                            change="onComboboxChange"
                            items="{path: '/F4_UploadTypeSet'}"
                            valueState="{viewModel>/valueState/selectedType}"
                            valueStateText="{viewModel>/valueStateText/selectedType}"
                        >
                            <core:ListItem
                                key="{UPLOAD_TYPE}"
                                text="{UPLOAD_TYPE_TEXT}"
                            />
                        </ComboBox>
                    </f:content>
                </f:SimpleForm>
            </VBox>
        </content>
        <beginButton>
            <Button
                text="{i18n>okBtnText}"
                press="onTypeSelect"
                type="Emphasized"
            />
        </beginButton>
        <endButton>
            <Button
                text="{i18n>cancelbtnText}"
                press="onCloseDialog"
                type="Transparent"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>

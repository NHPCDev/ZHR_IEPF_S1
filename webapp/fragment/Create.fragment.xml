<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    class="sapUiSizeCompact"
>
    <Dialog
        id="idCreateDialog"
        title="{i18n>createDialogTitle}"
        draggable="false"
        titleAlignment="Center"
        class="sapUiSizeCompact"
        contentWidth="25rem"
    >
        <content>
            <VBox>
            <!-- Start of Change: 08.10.2026 : Balamurugan : Financial Year and Month-Year Fields Added -->
                <f:SimpleForm
                    editable="true"
                    layout="ColumnLayout"
                >
            <!-- End of Change: 08.10.2026 : Balamurugan : Financial Year and Month-Year Fields Added -->
                    <f:content>
                        <Label
                            text="{i18n>chooseType}"
                            required="true"
                        />
                        <ComboBox
                            width="100%"
                            selectedItem="{viewModel>/selectedType}"
                            selectedKey="{viewModel>/selectedType}"
                            change="onComboboxChange"
                            items="{path: '/F4_UploadTypeSet'}"
                            valueState="{viewModel>/valueState/selectedType}"
                            valueStateText="{viewModel>/valueStateText/selectedType}"
                        >
                            <core:ListItem
                                key="{UPLOAD_TYPE}"
                                text="{UPLOAD_TYPE_TEXT}"
                            />
                        </ComboBox>
                        <!-- Start of Change: 08.10.2026 : Balamurugan : Financial Year and Month-Year Fields Added -->
                        <Label
                            text="{i18n>finYear}"
                            required="true"
                        />
                        <ComboBox
                            width="100%"
                            selectedItem="{viewModel>/finYear}"
                            selectedKey="{viewModel>/finYear}"
                            change="onComboboxChange"
                            items="{path: '/ZHCM_IEPF_CDS_FINYEAR_F4H'}"
                            valueState="{viewModel>/valueState/finYear}"
                            valueStateText="{viewModel>/valueStateText/finYear}"
                            visible="{= ${viewModel>/selectedType} === 'D'}"
                        >
                            <core:ListItem
                                key="{finyear}"
                                text="{finyear}"
                            />
                        </ComboBox>
                        <Label
                            text="{i18n>monYear}"
                            required="true"
                        />
                        <DatePicker
                            id="idMonthYear"
                            displayFormat="MM.yyyy"
                            valueFormat="MM.yyyy"
                            value="{viewModel>/monthYear}"
                            visible="{= ${viewModel>/selectedType} === 'S'}"
                            change="onMonthYearChange"
                            valueState="{viewModel>/valueState/monthYear}"
                            valueStateText="{viewModel>/valueStateText/monthYear}"
                        />
                        <!-- End of Change: 08.10.2026 : Balamurugan : Financial Year and Month-Year Fields Added -->
                    </f:content>
                </f:SimpleForm>
            </VBox>
        </content>
        <beginButton>
            <Button
                text="{i18n>okBtnText}"
                press="onTypeSelect"
                type="Emphasized"
            />
        </beginButton>
        <endButton>
            <Button
                text="{i18n>cancelbtnText}"
                press="onCloseDialog"
                type="Transparent"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>

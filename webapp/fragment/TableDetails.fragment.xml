<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:rowmodes="sap.ui.table.rowmodes"
    xmlns:unified="sap.ui.unified"
    xmlns:core="sap.ui.core"
    class="sapUiSizeCompact"
>
    <table:Table
        id="idSharesTable"
        rows="{sharesModel>/data}"
        selectionMode="None"
        width="auto"
        visible="{= ${viewModel>/selectedType} === 'S'}"
        alternateRowColors="true"
    >
        <table:extension>
            <OverflowToolbar>
                <Title
                    text="{= ${i18n>records} + ' (' + ${sharesModel>/data}.length + ')' }"
                    level="H2"
                />

                <ToolbarSpacer />

                <Button
                    text="{i18n>downloadTemplateBtnText}"
                    press="onDownloadTemplate"
                    icon="sap-icon://download"
                    type="Reject"
                    visible="{= ${viewModel>/requestDetails/Status} !== '02' }"
                />

                <unified:FileUploader
                    id="fileUploader"
                    sameFilenameAllowed="true"
                    iconOnly="false"
                    buttonOnly="true"
                    fileType="XLSX"
                    typeMissmatch="onFileTypeMissmatch"
                    icon="sap-icon://upload"
                    iconFirst="true"
                    change="onFileChange"
                    visible="{= ${viewModel>/requestDetails/Status} !== '02' }"
                    style="Accept"
                    buttonText="{i18n>uploadBtnText}"
                />
                <Button
                    id="_IDGenButton"
                    text="{i18n>downloadReportBtnText}"
                    icon="sap-icon://excel-attachment"
                    visible="{= ${viewModel>/requestDetails/Status} === '02' }"
                    press="onDownload"
                    type="Reject"
                />
            </OverflowToolbar>
        </table:extension>

        <table:rowMode>
            <rowmodes:Fixed
                id="_IDGenFixed1"
                rowCount="5"
            />
        </table:rowMode>
        <table:columns>
            <table:Column id="_IDGenColumn">
                <Label
                    id="_IDGenLabel"
                    text="{i18n>dpIdClientIdFolioNo}"
                />
                <table:template>
                    <Text
                        id="_IDGenText"
                        text="{sharesModel>DP_ID_CLIENT_ID_FOLIO_NO}"
                    />
                </table:template>
            </table:Column>
            <table:Column id="_IDGenColumn1">
                <Label
                    id="_IDGenLabel1"
                    text="{i18n>investorsName}"
                />
                <table:template>
                    <Text
                        id="_IDGenText1"
                        text="{sharesModel>INVESTORS_NAME}"
                    />
                </table:template>
            </table:Column>
            <table:Column id="_IDGenColumn2">
                <Label
                    id="_IDGenLabel2"
                    text="{i18n>totalShares}"
                />
                <table:template>
                    <Text
                        id="_IDGenText2"
                        text="{sharesModel>TOTAL_SHARES}"
                    />
                </table:template>
            </table:Column>
            <table:Column id="_IDGenColumn3">
                <Label
                    id="_IDGenLabel3"
                    text="{i18n>remarks}"
                />
                <table:template>
                    <Text
                        id="_IDGenText3"
                        text="{sharesModel>REMARKS}"
                    />
                </table:template>
            </table:Column>
        </table:columns>
    </table:Table>
    <table:Table
        id="idDividendTable"
        rows="{dividendModel>/data}"
        selectionMode="None"
        visible="{= ${viewModel>/selectedType} === 'D'}"
        alternateRowColors="true"
        fixedColumnCount="1"
    >
        <table:extension>
            <OverflowToolbar>
                <Title
                    text="{= ${i18n>records} + ' (' + ${dividendModel>/data}.length + ')' }"
                    level="H2"
                />
                <ToolbarSpacer />
                <Button
                    text="{i18n>downloadTemplateBtnText}"
                    press="onDownloadTemplate"
                    icon="sap-icon://download"
                    type="Reject"
                    visible="{= ${viewModel>/requestDetails/Status} !== '02' }"
                />

                <unified:FileUploader
                    id="fileUploader1"
                    sameFilenameAllowed="true"
                    iconOnly="false"
                    buttonOnly="true"
                    fileType="XLSX"
                    icon="sap-icon://upload"
                    iconFirst="true"
                    change="onFileChange"
                    visible="{= ${viewModel>/requestDetails/Status} !== '02' }"
                    style="Accept"
                    buttonText="{i18n>uploadBtnText}"
                />
                <Button
                    id="_IDGenButton1"
                    text="{i18n>downloadReportBtnText}"
                    icon="sap-icon://excel-attachment"
                    visible="{= ${viewModel>/requestDetails/Status} === '02' }"
                    press="onDownload"
                    type="Reject"
                />
            </OverflowToolbar>
        </table:extension>
        <table:rowMode>
            <rowmodes:Fixed
                id="_IDGenFixed2"
                rowCount="5"
            />
        </table:rowMode>
        <table:columns>
            <table:Column
                id="_IDGenColumn4"
                width="200px"
            >
                <Label
                    id="_IDGenLabel4"
                    text="{i18n>dpIdClientIdFolioNo}"
                />
                <table:template>
                    <Text
                        id="_IDGenText4"
                        text="{dividendModel>DP_ID_CLIENT_ID_FOLIO_NO}"
                    />
                </table:template>
            </table:Column>
            <table:Column
                id="_IDGenColumn5"
                width="200px"
            >
                <Label
                    id="_IDGenLabel5"
                    text="{i18n>investorsName}"
                />
                <table:template>
                    <Text
                        id="_IDGenText5"
                        text="{dividendModel>INVESTORS_NAME}"
                    />
                </table:template>
            </table:Column>
            <table:Column
                id="_IDGenColumn6"
                width="200px"
            >
                <Label
                    id="_IDGenLabel6"
                    text="{i18n>dividendAmount}"
                />
                <table:template>
                    <Text
                        id="_IDGenText6"
                        text="{dividendModel>DIVIDEND_AMOUNT}"
                    />
                </table:template>
            </table:Column>
            <table:Column
                id="_IDGenColumn7"
                width="200px"
            >
                <Label
                    id="_IDGenLabel7"
                    text="{i18n>address1}"
                />
                <table:template>
                    <Text
                        id="_IDGenText7"
                        text="{dividendModel>ADDRESS1}"
                    />
                </table:template>
            </table:Column>
            <table:Column
                id="_IDGenColumn8"
                width="200px"
            >
                <Label
                    id="_IDGenLabel8"
                    text="{i18n>address2}"
                />
                <table:template>
                    <Text
                        id="_IDGenText8"
                        text="{dividendModel>ADDRESS2}"
                    />
                </table:template>
            </table:Column>
            <table:Column
                id="_IDGenColumn9"
                width="200px"
            >
                <Label
                    id="_IDGenLabel9"
                    text="{i18n>address3}"
                />
                <table:template>
                    <Text
                        id="_IDGenText9"
                        text="{dividendModel>ADDRESS3}"
                    />
                </table:template>
            </table:Column>
            <table:Column
                id="_IDGenColumn10"
                width="200px"
            >
                <Label
                    id="_IDGenLabel10"
                    text="{i18n>address4}"
                />
                <table:template>
                    <Text
                        id="_IDGenText10"
                        text="{dividendModel>ADDRESS4}"
                    />
                </table:template>
            </table:Column>
            <table:Column
                id="_IDGenColumn11"
                width="150px"
            >
                <Label
                    id="_IDGenLabel11"
                    text="{i18n>pin}"
                />
                <table:template>
                    <Text
                        id="_IDGenText11"
                        text="{dividendModel>PIN}"
                    />
                </table:template>
            </table:Column>
            <table:Column
                id="_IDGenColumn12"
                width="200px"
            >
                <Label
                    id="_IDGenLabel12"
                    text="{i18n>dueDate}"
                />
                <table:template>
                    <Text
                        id="_IDGenText12"
                        text="{dividendModel>Due_Date}"
                    />
                </table:template>
            </table:Column>
            <table:Column
                id="_IDGenColumn13"
                width="500px"
            >
                <Label
                    id="_IDGenLabel13"
                    text="{i18n>remarks}"
                />
                <table:template>
                    <Text
                        id="_IDGenText13"
                        text="{dividendModel>REMARKS}"
                    />
                </table:template>
            </table:Column>
        </table:columns>
    </table:Table>
</core:FragmentDefinition>

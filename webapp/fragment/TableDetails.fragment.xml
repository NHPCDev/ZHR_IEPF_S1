<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:rowmodes="sap.ui.table.rowmodes"
    xmlns:unified="sap.ui.unified"
    xmlns:core="sap.ui.core"
    class="sapUiSizeCompact"
>
    <table:Table
        id="idSharesTable"
        rows="{sharesModel>/data}"
        selectionMode="None"
        width="auto"
        visible="{= ${viewModel>/selectedType} === 'S'}"
        alternateRowColors="true"
        fixedColumnCount="2"
    >
        <table:extension>
            <OverflowToolbar>
                <Title
                    text="{= ${i18n>records} + ' (' + ${sharesModel>/data}.length + ')' }"
                    level="H2"
                />

                <ToolbarSpacer />

                <Button
                    text="{i18n>downloadTemplateBtnText}"
                    press="onDownloadTemplate"
                    icon="sap-icon://download"
                    type="Reject"
                    visible="{= ${viewModel>/requestDetails/Status} !== '01' &amp;&amp; ${viewModel>/requestDetails/Status} !== '02' }"
                />

                <unified:FileUploader
                    id="fileUploader"
                    sameFilenameAllowed="true"
                    iconOnly="false"
                    buttonOnly="true"
                    fileType="XLSX"
                    typeMissmatch="onFileTypeMissmatch"
                    icon="sap-icon://upload"
                    iconFirst="true"
                    change="onFileChange"
                    visible="{= ${viewModel>/requestDetails/Status} !== '01' &amp;&amp; ${viewModel>/requestDetails/Status} !== '02' }"
                    style="Accept"
                    buttonText="{i18n>uploadBtnText}"
                />
                <Button
                    id="_IDGenButton"
                    text="{i18n>downloadReportBtnText}"
                    icon="sap-icon://excel-attachment"
                    visible="{= ${viewModel>/requestDetails/Status} === '01'|| ${viewModel>/requestDetails/Status} === '02' }"
                    press="onDownload"
                    type="Reject"
                />
            </OverflowToolbar>
        </table:extension>

        <table:rowMode>
            <rowmodes:Fixed
                id="_IDGenFixed1"
                rowCount="5"
            />
        </table:rowMode>
        <table:columns>
            <table:Column width="250px">
                <Label
                    text="{i18n>dpId}"
                />
                <table:template>
                    <Text
                        text="{sharesModel>Invdpid}"
                    />
                </table:template>
            </table:Column>
            <table:Column width="250px">
                <Label
                    text="{i18n>clientID}"
                />
                <table:template>
                    <Text
                        text="{sharesModel>Invclientid}"
                    />
                </table:template>
            </table:Column>
            <table:Column width="200px">
                <Label
                    text="{i18n>folioNumber}"
                />
                <table:template>
                    <Text
                        text="{sharesModel>Invfolionumber}"
                    />
                </table:template>
            </table:Column>
            <table:Column width="250px">
                <Label
                    text="{i18n>investorFirstName}"
                />
                <table:template>
                    <Text
                        text="{sharesModel>Invfname}"
                    />
                </table:template>
            </table:Column>
            <table:Column width="250px">
                <Label
                    text="{i18n>investorMiddleName}"
                />
                <table:template>
                    <Text
                        text="{sharesModel>Invsmname}"
                    />
                </table:template>
            </table:Column>
            <table:Column width="250px">
                <Label
                    text="{i18n>investorLastName}"
                />
                <table:template>
                    <Text
                        text="{sharesModel>Invlname}"
                    />
                </table:template>
            </table:Column>
            <table:Column width="250px">
                <Label
                    text="{i18n>fatherHusbandFirstName}"
                />
                <table:template>
                    <Text
                        text="{sharesModel>Invfhfname}"
                    />
                </table:template>
            </table:Column>
            <table:Column width="250px">
                <Label
                    text="{i18n>fatherHusbandMiddleName}"
                />
                <table:template>
                    <Text
                        text="{sharesModel>Invfhmname}"
                    />
                </table:template>
            </table:Column>
            <table:Column width="250px">
                <Label
                    text="{i18n>fatherHusbandLastName}"
                />
                <table:template>
                    <Text
                        text="{sharesModel>Invfhlname}"
                    />
                </table:template>
            </table:Column>
            <table:Column width="400px">
                <Label
                    text="{i18n>address}"
                />
                <table:template>
                    <Text
                        text="{sharesModel>Invaddress}"
                    />
                </table:template>
            </table:Column>
            <table:Column width="100px">
                <Label
                    text="{i18n>country}"
                />
                <table:template>
                    <Text
                        text="{sharesModel>Invcountry}"
                    />
                </table:template>
            </table:Column>
            <table:Column width="100px">
                <Label
                    text="{i18n>state}"
                />
                <table:template>
                    <Text
                        text="{sharesModel>Invstate}"
                    />
                </table:template>
            </table:Column>
            <table:Column width="100px">
                <Label
                    text="{i18n>district}"
                />
                <table:template>
                    <Text
                        text="{sharesModel>Invdistrict}"
                    />
                </table:template>
            </table:Column>
            <table:Column width="100px">
                <Label
                    text="{i18n>pinCode}"
                />
                <table:template>
                    <Text
                        text="{sharesModel>Invpincode}"
                    />
                </table:template>
            </table:Column>
            <table:Column width="200px">
                <Label
                    text="{i18n>numberOfShares}"
                />
                <table:template>
                    <Text
                        text="{sharesModel>Invnoofshares}"
                    />
                </table:template>
            </table:Column>
            <table:Column width="250px">
                <Label
                    text="{i18n>nominalValueOfShares}"
                />
                <table:template>
                    <Text
                        text="{sharesModel>Invnominalvalueofshare}"
                    />
                </table:template>
            </table:Column>
            <table:Column width="250px">
                <Label
                    text="{i18n>actualDateOfTransferToIEPF}"
                />
                <table:template>
                    <Text
                        text="{sharesModel>Invdateofsharetransfer2iepf}"
                    />
                </table:template>
            </table:Column>
        </table:columns>
    </table:Table>
    <table:Table
        id="idDividendTable"
        rows="{dividendModel>/data}"
        selectionMode="None"
        visible="{= ${viewModel>/selectedType} === 'D'}"
        alternateRowColors="true"

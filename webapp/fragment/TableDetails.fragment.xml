                </table:template>
            </table:Column>
            <table:Column width="250px">
                <Label
                    text="{i18n>investorLastName}"
                />
                <table:template>
                    <Text
                        text="{dividendModel>Invlname}"
                    />
                </table:template>
            </table:Column>
            <table:Column width="250px">
                <Label
                    text="{i18n>fatherHusbandFirstName}" 
                />
                <table:template>
                    <Text
                        text="{dividendModel>Invfhfname}"
                    />
                </table:template>
            </table:Column>
            <table:Column width="250px">
                <Label
                    text="{i18n>fatherHusbandMiddleName}"
                />
                <table:template>
                    <Text
                        text="{dividendModel>Invfhmname}"
                    />
                </table:template>
            </table:Column>
            <table:Column width="250px">
                <Label
                    text="{i18n>fatherHusbandLastName}"
                />
                <table:template>
                    <Text
                        text="{dividendModel>Invfhlname}"
                    />
                </table:template>
            </table:Column>
            <table:Column width="400px">
                <Label
                    text="{i18n>address}"
                />
                <table:template>
                    <Text
                        text="{dividendModel>Invaddress}"
                    />
                </table:template>
            </table:Column>
            <table:Column width="100px">
                <Label
                    text="{i18n>country}"
                />
                <table:template>
                    <Text
                        text="{dividendModel>Invcountry}"
                    />
                </table:template>
            </table:Column>
            <table:Column width="100px">
                <Label
                    text="{i18n>state}"
                />
                <table:template>
                    <Text
                        text="{dividendModel>Invstate}"
                    />
                </table:template>
            </table:Column>
            <table:Column width="100px">
                <Label
                    text="{i18n>district}"
                />
                <table:template>
                    <Text
                        text="{dividendModel>Invdistrict}"
                    />
                </table:template>
            </table:Column>
            <table:Column width="100px">
                <Label
                    text="{i18n>pinCode}"
                />
                <table:template>
                    <Text
                        text="{dividendModel>Invpincode}"
                    />
                </table:template>
            </table:Column>
            <table:Column width="300px">
                <Label
                    text="{i18n>investmentType}"
                />
                <table:template>
                    <Text
                        text="{dividendModel>Investmenttype}"
                    />
                </table:template>
            </table:Column>
            <table:Column width="150px">
                <Label
                    text="{i18n>amountTransferred}"
                />
                <table:template>
                    <Text
                        text="{dividendModel>Invamounttransfered}"
                    />
                </table:template>
            </table:Column>
            <table:Column width="150px">
                <Label
                    text="{i18n>dateOfEvent}"
                />
                <table:template>
                    <Text
                        text="{dividendModel>Invdateofevent}"
                    />
                </table:template>
            </table:Column>
        </table:columns>
    </table:Table>
</core:FragmentDefinition>
